      "html": "<button class=\"ds-frame\" aria-label=\"Review scene 1\"><span class=\"ds-frame-viewport\"><span class=\"ds-frame-index\">01</span><span class=\"ds-frame-placeholder\">Scene preview</span><span class=\"ds-frame-expand\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><path d=\"M15 3h6v6M21 3l-7 7M9 21H3v-6m0 6 7-7\"/></svg></span></span><span class=\"ds-frame-title\">A golden beginning</span><span class=\"ds-frame-caption\">Sample frame for visual review.</span></button>",
      "css": ".ds-frame{display:block;width:160px;padding:0;border:0;background:none;color:#242932;text-align:left;cursor:pointer;font-family:\"DM Sans\",sans-serif;}.ds-frame-viewport{display:block;position:relative;aspect-ratio:9/16;max-height:300px;background:#e7ebf2;border-radius:12px;overflow:hidden}.ds-frame-placeholder{display:flex;height:100%;align-items:center;justify-content:center;padding:10px;color:#74839d;font-size:11px;text-align:center}.ds-frame-index{position:absolute;top:11px;left:11px;font-size:10px;font-weight:500;background:rgba(255,255,255,.9);color:#323c47;padding:3px 7px;border-radius:5px}.ds-frame-expand{position:absolute;right:10px;bottom:10px;width:28px;height:28px;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,.9);border-radius:50%;opacity:0;transition:opacity .2s}.ds-frame:hover .ds-frame-expand,.ds-frame:focus-visible .ds-frame-expand{opacity:1}.ds-frame:focus-visible{outline:2px solid #425c9b;outline-offset:4px;}.ds-frame-title{display:block;font-size:12px;font-weight:500;margin:10px 0 3px}.ds-frame-caption{display:block;font-size:10px;line-height:1.65;color:#656c79}@media(prefers-reduced-motion:reduce){.ds-frame-expand{transition:none}}"
