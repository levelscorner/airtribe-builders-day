{
  "name": "chotu-mini-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/deploy/start.ts",
    "start:legacy": "tsx src/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.contract.json",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.contract.json",
    "test": "tsx --test src/credits/*.test.ts src/payments/*.test.ts src/render/*.test.ts src/admin/*.test.ts",
    "test:mock": "tsx src/scripts/smoke-mock.ts"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^0.0.14",
    "@ai-sdk/openai": "^1.3.22",
    "ai": "^4.3.16",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "pg": "^8.23.1",
    "sharp": "^0.34.1",
    "uuid": "^11.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
