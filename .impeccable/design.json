    {
      "name": "Active Configuration",
      "kind": "card",
      "refersTo": "configuration",
      "description": "The single active question surface; application logic replaces its contents after an answer.",
      "html": "<section class=\"ds-config\" aria-label=\"Video configuration\"><h2 class=\"ds-config-title\">What language feels right?</h2><div class=\"ds-config-choices\"><button class=\"ds-choice\">Hindi</button><button class=\"ds-choice\">Hinglish</button><button class=\"ds-choice\">English</button></div></section>",
      "css": ".ds-config{max-width:620px;padding:25px 26px 22px;border:1px solid #e2e5eb;background:#fff;border-radius:18px;color:#242932;font-family:\"DM Sans\",sans-serif;}.ds-config-title{font-size:23px;line-height:1.45;font-weight:500;letter-spacing:-.45px;margin:0 0 22px}.ds-config-choices{display:flex;gap:8px;flex-wrap:wrap}.ds-choice{min-height:42px;border:1px solid #e2e5eb;border-radius:11px;padding:11px 15px;font-size:13px;background:#f8f9fb;color:#242932;cursor:pointer;font-family:\"DM Sans\",sans-serif;}.ds-choice:hover{background:#eaf0fd;border-color:#a8bbdf;color:#425c9b}.ds-choice:focus-visible{outline:2px solid #425c9b;outline-offset:4px;}.ds-choice:disabled{opacity:.45;cursor:default}@media(max-width:760px){.ds-config{padding:21px 18px}.ds-config-title{font-size:21px}}"
    },
    {
      "name": "Completed Video Plan",
      "kind": "card",
      "refersTo": "configuration-summary",
      "description": "The single persisted assistant summary after intake is complete.",
      "html": "<section class=\"ds-summary\" aria-label=\"Video configuration summary\"><h2 class=\"ds-summary-title\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><path d=\"m5 12 4 4L19 6\"/></svg>Here’s your video plan.</h2><dl class=\"ds-summary-grid\"><div><dt class=\"ds-term\">Language</dt><dd class=\"ds-value\">Hindi</dd></div><div><dt class=\"ds-term\">Duration</dt><dd class=\"ds-value\">30 seconds</dd></div><div><dt class=\"ds-term\">Style</dt><dd class=\"ds-value\">Warm and cinematic</dd></div><div><dt class=\"ds-term\">Format</dt><dd class=\"ds-value\">Vertical</dd></div></dl></section>",
      "css": ".ds-summary{max-width:620px;padding:22px 24px;background:#eff2f8;border-radius:15px;color:#242932;font-family:\"DM Sans\",sans-serif;}.ds-summary-title{display:flex;align-items:center;gap:9px;font-size:18px;line-height:1.5;font-weight:500;letter-spacing:-.3px;margin:0 0 21px}.ds-summary-title svg{color:#425c9b}.ds-summary-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px 28px;margin:0}.ds-term{font-size:11px;color:#626c7c;margin-bottom:4px}.ds-value{font-size:13px;margin:0;line-height:1.6;overflow-wrap:anywhere}@media(max-width:760px){.ds-summary{padding:20px}.ds-summary-grid{gap:16px 20px}.ds-value{font-size:12px}}"
    },
    {
      "name": "Frame Preview",
