# Copy to server/.env. On Replit, paste the same names into Secrets.
# Never commit .env or put real keys in this file.
#
# Start from the repo root:
#   npm start
# That runs one process (tsx server/src/deploy/start.ts):
#   /v1/*  API (packs, webhook, download)
#   /admin and /admin/export.csv
#   /media rendered MP4s
#   /      Expo web if server/public/index.html exists, otherwise a status page
#
# The older chotu-mini job API is still `npm run server` (start:legacy).
# PINE_LABS_MOCK defaults to on: checkout returns a fake payment link and the
# pay page posts a simulated webhook. Set it to 0 only when the three Pine Labs
# secrets below are set. Those calls stay on Plural UAT. MOCK=1 also keeps the
# fake link.
# PINE_LABS_WEBHOOK_SECRET is the base64 dashboard secret, not a raw string.

# --- docs/14 environment (required names) ---
DATABASE_URL=
HIGGSFIELD_API_KEY=
ELEVENLABS_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
LLM_PROVIDER=
PINE_LABS_MOCK=1
PINE_LABS_MERCHANT_ID=
PINE_LABS_API_KEY=
PINE_LABS_WEBHOOK_SECRET=
RENDER_API_KEY=
RENDER_WORKFLOW_TASK=chotu-render/assemble
MOCK=1
# AgenticOrg script review (Pine Labs). Blank uses the mock review.
AGENTICORG_AGENT_ID=
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
STARTER_CREDITS=

# --- legacy chotu-mini server (npm run server) ---
MOCK_MODE=true
OPENAI_API_KEY=
VISUALS_PROVIDER=mock
MOCK_VISUALS_CLIPS=false
HIGGSFIELD_MCP_URL=https://mcp.higgsfield.ai/mcp
HIGGSFIELD_MCP_TOKEN=
HIGGSFIELD_MCP_TRANSPORT=http
HIGGSFIELD_IMAGE_TOOL=generate_image
HIGGSFIELD_VIDEO_TOOL=image_to_video
HIGGSFIELD_STATUS_TOOL=get_generation
OPENART_MCP_URL=https://mcp.openart.ai/mcp
OPENART_MCP_TOKEN=
OPENART_MCP_TRANSPORT=http
ELEVENLABS_MCP_URL=https://api.elevenlabs.io/v1/mcp
ELEVENLABS_MCP_TRANSPORT=http
ELEVENLABS_TTS_TOOL=text_to_speech
ELEVENLABS_VOICE_ID=

# Async MCP job polling
MCP_POLL_TIMEOUT_MS=180000
MCP_POLL_INTERVAL_MS=3000

# --- Chotu Studio media ports (server/src/media) ---
# MOCK=1 forces ImageGen, ClipGen, VoiceGen, and the cast adapter to return
# placeholder jobs. Per-module overrides: 1 mock, 0 live.
MOCK=1
# IMAGE_MOCK=
# CLIP_MOCK=
# VOICE_MOCK=
# CAST_MOCK=
# Higgsfield REST key. Prefer ID:SECRET in one of these (server-side only):
# HIGGSFIELD_API_KEY, HF_CREDENTIALS, or HF_KEY. Split form also works:
# HF_API_KEY_ID=
# HF_API_KEY_SECRET=
ELEVENLABS_API_KEY=
# Optional JSON array that replaces the provisional Hindi voice presets.
# VOICE_PRESETS_JSON=
# Seedance output tier when ClipGen input has no resolution field: 480p|720p|1080p|4k
CLIP_RESOLUTION=720p
# Parallel Higgsfield submits. Polling does not take a slot.
MEDIA_CONCURRENCY=4
# Where live voice bytes are written. Mock mode does not use this.
# MEDIA_DIR=
# How long to poll a Higgsfield request before failing it. Default 180000.
# HF_POLL_TIMEOUT_MS=180000
