    {
      "name": "Prompt Composer",
      "kind": "input",
      "refersTo": "composer",
      "description": "A white input surface with shared container focus and a graphite send action.",
      "html": "<div class=\"ds-composer\"><textarea class=\"ds-prompt\" aria-label=\"Your idea\" placeholder=\"Tell me what you have in mind…\" rows=\"2\"></textarea><div class=\"ds-tools\"><button class=\"ds-attach\" aria-label=\"Attach reference\"><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><path d=\"m8 13 6-6a3 3 0 0 1 4 4l-8 8a5 5 0 0 1-7-7l9-9\"/></svg></button><button class=\"ds-send\" aria-label=\"Send idea\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><path d=\"M12 19V5m-6 6 6-6 6 6\"/></svg></button></div></div>",
      "css": ".ds-composer{width:min(100%,600px);background:#fff;border-radius:24px;padding:16px 18px 12px;box-shadow:0 6px 28px rgba(41,53,80,.055);transition:box-shadow .2s;font-family:\"DM Sans\",sans-serif;}.ds-composer:focus-within{box-shadow:0 5px 30px rgba(55,78,124,.1)}.ds-prompt{display:block;width:100%;resize:none;border:0;outline:none;background:transparent;color:#242932;font-size:15px;line-height:1.65;padding:5px 6px 8px;caret-color:#425c9b;font-family:\"DM Sans\",sans-serif;}.ds-prompt::placeholder{color:#656d79;opacity:1}.ds-tools{display:flex;justify-content:space-between;align-items:center;gap:10px}.ds-attach,.ds-send{display:flex;align-items:center;justify-content:center;border:0;border-radius:50%;cursor:pointer}.ds-attach{width:40px;height:40px;background:none;color:#242932}.ds-attach:hover{background:#e5e8ef}.ds-send{width:36px;height:36px;background:#242932;color:#fff}.ds-send:hover{background:#425c9b}.ds-attach:focus-visible,.ds-send:focus-visible{outline:2px solid #425c9b;outline-offset:4px;}.ds-send:disabled{background:#e8ebf0;color:#626c7b;cursor:default}@media(prefers-reduced-motion:reduce){.ds-composer{transition:none}}"
    },
