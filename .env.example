# Copy into server/.env. App uses EXPO_PUBLIC_API_URL.

MOCK_MODE=true
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787

# Pine Labs credit packs. Defaults on: checkout returns a fake payment link
# (${PUBLIC_BASE_URL}/v1/packs/mock-pay). The pay page posts a simulated
# webhook that credits the ledger once through the same ref as a real capture.
# Set to 0 only when the three credentials below are set. Those calls stay on
# Plural UAT (https://pluraluat.v2.pinepg.in). MOCK=1 also keeps the fake link.
PINE_LABS_MOCK=1
PINE_LABS_MERCHANT_ID=
PINE_LABS_API_KEY=
PINE_LABS_WEBHOOK_SECRET=

OPENAI_API_KEY=

VISUALS_PROVIDER=mock
MOCK_VISUALS_CLIPS=false

HIGGSFIELD_MCP_URL=https://mcp.higgsfield.ai/mcp
HIGGSFIELD_MCP_TOKEN=
HIGGSFIELD_MCP_TRANSPORT=http
HIGGSFIELD_IMAGE_TOOL=generate_image
HIGGSFIELD_VIDEO_TOOL=image_to_video
HIGGSFIELD_STATUS_TOOL=get_generation

OPENART_MCP_URL=https://mcp.openart.ai/mcp
OPENART_MCP_TOKEN=
OPENART_MCP_TRANSPORT=http

ELEVENLABS_MCP_URL=https://api.elevenlabs.io/v1/mcp
ELEVENLABS_MCP_TRANSPORT=http
ELEVENLABS_TTS_TOOL=text_to_speech
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# EXPO_PUBLIC_API_URL=https://your-replit-url.repl.co
