      "html": "<nav class=\"ds-nav\" aria-label=\"Recent conversations\"><button class=\"ds-nav-item ds-current\" aria-current=\"page\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><path d=\"M21 11a8 8 0 0 1-8 8H5l-3 3V11a9 9 0 0 1 19 0Z\"/></svg><span class=\"ds-nav-title\">A story about honey</span></button><button class=\"ds-nav-item\">Morning coffee ad</button></nav>",
      "css": ".ds-nav{display:grid;gap:7px;width:236px;padding:12px;background:#eff1f5;font-family:\"DM Sans\",sans-serif;}.ds-nav-item{display:flex;align-items:center;gap:12px;min-height:44px;padding:8px 12px;border:0;border-radius:10px;background:none;color:#242932;font-size:13px;text-align:left;cursor:pointer;font-family:\"DM Sans\",sans-serif;}.ds-nav-title{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ds-nav-item:hover,.ds-current{background:#e2e7ef}.ds-nav-item:focus-visible{outline:2px solid #425c9b;outline-offset:4px;}"
