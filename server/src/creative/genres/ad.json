      "allowFreeText": true,
      "allowSkip": true,
      "allowDefaults": true
    },
    {
      "field": "product",
      "prompt": "Describe the product in a few plain words (shape, colour, what it is). No brand slogans.",
      "allowFreeText": true,
      "allowSkip": true,
      "allowDefaults": true
    }
  ],
  "skillRefs": ["cards-format-advert", "cards-format-product", "cards-format-ugc"]
