{
  "name": "chotu-mini-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test:mock": "tsx src/scripts/smoke-mock.ts",
    "test:creative": "tsx --test src/creative/*.test.ts src/creative/**/*.test.ts",
    "sample:creative": "tsx src/creative/sample.ts",
    "test:media": "MOCK=1 tsx --test src/media/ports.mock.test.ts src/media/live.test.ts"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^0.0.14",
    "@ai-sdk/openai": "^1.3.22",
    "@chotu/shared": "file:../packages/shared",
    "ai": "^4.3.16",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "sharp": "^0.34.1",
    "uuid": "^11.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
