{
  "id": "ad",
  "label": "Ad",
  "who": "small brands, D2C, local shops",
  "tone": "punchy, benefit-led",
  "shape": "hook, problem, product, offer, CTA, 20-30s",
  "beats": ["hook", "problem", "product", "offer", "cta"],
  "defaultTargetSeconds": 25,
  "minSeconds": 20,
  "maxSeconds": 30,
  "defaultResolution": "1080p",
  "defaultAspectRatio": "9:16",
  "defaultLanguage": "hinglish",
  "defaultAudience": "Shoppers at a small Indian brand or local shop",
