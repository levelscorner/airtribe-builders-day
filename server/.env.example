# Mock mode: set true (or leave live MCP tokens unset) to demo without paid APIs.
MOCK_MODE=true
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787

# Script generation (OpenAI) — still used by Script node unless MOCK_MODE
OPENAI_API_KEY=

# Visuals provider: mock | higgsfield | openart
VISUALS_PROVIDER=mock
# Optional: mock emits short MP4 clips per scene (tests clip render path)
MOCK_VISUALS_CLIPS=false

# --- Higgsfield MCP (images + image-to-video) ---
# Default URL: https://mcp.higgsfield.ai/mcp
HIGGSFIELD_MCP_URL=https://mcp.higgsfield.ai/mcp
HIGGSFIELD_MCP_TOKEN=
HIGGSFIELD_MCP_TRANSPORT=http
# Tool names are matched exactly, then by substring alias at startup discovery
HIGGSFIELD_IMAGE_TOOL=generate_image
HIGGSFIELD_VIDEO_TOOL=image_to_video
HIGGSFIELD_STATUS_TOOL=get_generation
HIGGSFIELD_ENABLE_I2V=true

# --- OpenArt MCP (no public REST API; MCP is the path) ---
OPENART_MCP_URL=https://mcp.openart.ai/mcp
OPENART_MCP_TOKEN=
OPENART_MCP_TRANSPORT=http
OPENART_IMAGE_TOOL=generate_image
OPENART_VIDEO_TOOL=generate_video
OPENART_STATUS_TOOL=get_generation

# --- ElevenLabs MCP TTS + REST fallback ---
ELEVENLABS_MCP_URL=https://api.elevenlabs.io/v1/mcp
ELEVENLABS_MCP_TRANSPORT=http
ELEVENLABS_TTS_TOOL=text_to_speech
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Async MCP job polling
MCP_POLL_TIMEOUT_MS=180000
MCP_POLL_INTERVAL_MS=3000
