  "artStylePresets": [
    {
      "id": "clean-product-studio",
      "label": "Clean product studio",
      "traits": ["clean studio backdrop", "soft even light", "true product colour", "uncluttered tabletop"]
    },
    {
      "id": "cinematic-realistic",
      "label": "Cinematic realistic",
      "traits": ["natural light", "realistic textures", "shallow depth of field", "restrained colour"]
    },
    {
      "id": "bright-2d-cartoon",
      "label": "Bright 2D cartoon",
      "traits": ["bright flat colours", "bold clean outlines", "simple shapes", "even friendly light"]
    }
  ],
  "defaultArtStyle": "clean-product-studio",
  "defaultCastIds": ["preset_riya"],
